{
  "name": "ahar-vsvis",
  "displayName": "ahar-vsvis",
  "description": "Visualizes agent-harnesses-standard structure in a workspace.",
  "version": "0.0.1",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Visualization", "Other"],
  "activationEvents": ["onStartupFinished"],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aharVsvis.refresh",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "ahar-vsvis"
      },
      {
        "command": "aharVsvis.openTreeVisualization",
        "title": "Open Tree Visualization",
        "icon": "$(type-hierarchy)",
        "category": "ahar-vsvis"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.4.0"
  }
}
